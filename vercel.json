

{
  "version": 2,
  "builds": [
    {
      "src": "users.js",
      "use": "@vercel/node"
    },
    {
      "src": "categories.js",
      "use": "@vercel/node"
    },
    {
      "src": "products.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/users(.*)",
      "dest": "users.js"
    },
    {
      "src": "/categories(.*)",
      "dest": "categories.js"
    },
    {
      "src": "/products(.*)",
      "dest": "products.js"
    }
  ]
}

