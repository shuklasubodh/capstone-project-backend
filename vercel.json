{
  "version": 2,
  "builds": [
    {
      "src": "users.js",
      "use": "@vercel/node"
    },
    {
      "src": "orders.js",
      "use": "@vercel/node"
    },
    {
      "src": "order_items.js",
      "use": "@vercel/node"
    },
    {
      "src": "categories.js",
      "use": "@vercel/node"
    },
    {
      "src": "products.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/users(.*)",
      "dest": "users.js"
    },
    
    {
      "src": "/api/orders(.*)",
      "dest": "orders.js"
    },
    
    {
      "src": "/api/order-items(.*)",
      "dest": "order_items.js"
    },
    
    {
      "src": "/api/categories(.*)",
      "dest": "categories.js"
    },
    
    {
      "src": "/api/products(.*)",
      "dest": "products.js"
    }
    
  ]
}
